# Copia questo file in .env.local (sviluppo) e imposta gli stessi valori su Vercel.

# URL pubblico del sito, senza barra finale.
NEXT_PUBLIC_SITE_URL=https://www.topdieci.click

# ID di tracciamento Amazon Associates. Se vuoto si usa topdieci26-21 (impostato in src/lib/affiliate.ts).
AMAZON_ASSOCIATE_TAG=topdieci26-21

# Credenziali Amazon Creators API (Associates Central > Creators API).
# Servono solo allo script di aggiornamento, mai al browser.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_MARKETPLACE=www.amazon.it

# Facoltativo: URL a cui inoltrare gli eventi di clic (es. un webhook o un endpoint di analytics).
CLICK_WEBHOOK_URL=

# URL del token OAuth per la tua regione (lo trovi in Associates Central > Creators API).
AMAZON_CREATORS_TOKEN_URL=
# Facoltativi: da cambiare solo se la API Reference indica percorsi diversi.
# AMAZON_CREATORS_API_BASE=https://creatorsapi.amazon/catalog/v1
# AMAZON_CREATORS_GET_ITEMS_PATH=/getItems
